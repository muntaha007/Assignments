    "def calculate_average(marks1,marks2,marks3):\n",
    "    average=(marks1+marks2+marks3)/3\n",
    "    return average\n",
    "    \n",
    "def is_passes(average):\n",
    "    return average>=50\n",
    "average=calculate_average(67,88,79)\n",
    "passes=is_passes(average)\n",
    "print(\"is_passes:\",passes)\n",
    "\n",
    "def grade(marks):\n",
    "    if marks>=80:\n",
    "        return \"Grade A \"\n",
    "    if marks>=70:\n",
    "        return \"Grade B \"\n",
    "    if marks>=60:\n",
    "        return \"Grade c \"\n",
    "    else:\n",
    "        return \"Fail \"\n",
    "# Student Information\n",
    "student_name = \"Ali\"\n",
    "\n",
    "marks1 = 67\n",
    "marks2 = 88\n",
    "marks3 = 79\n",
    "\n",
    "# Calculate Average\n",
    "average = calculate_average(marks1, marks2, marks3)\n",
    "\n",
    "# Check Pass or Fail\n",
    "passed = is_passes(average)\n",
    "\n",
    "# Calculate Grade\n",
    "grade = grade(average)\n",
    "\n",
    "# Display Student Result\n",
    "print(\"----- Student Result -----\")\n",
    "print(\"Student Name:\", student_name)\n",
    "print(\"Book 1 Marks:\", marks1)\n",
    "print(\"Book 2 Marks:\", marks2)\n",
